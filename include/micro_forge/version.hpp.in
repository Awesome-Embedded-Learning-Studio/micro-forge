/**
 * @file version.hpp
 * @brief Engine version constants, generated by CMake configure.
 * @version @MICRO_FORGE_VERSION@
 */

#pragma once

#include <string_view>

namespace micro_forge {

/// Engine version constants, generated from the CMake project VERSION.
/// Single source of truth: project(... VERSION ...) in the top-level
/// CMakeLists.txt. Do not edit the generated header. Numeric components are
/// for comparisons (e.g. snapshot version triplets); the string is for
/// display and the wasm C ABI.
inline constexpr int kVersionMajor = @MICRO_FORGE_VERSION_MAJOR@;
inline constexpr int kVersionMinor = @MICRO_FORGE_VERSION_MINOR@;
inline constexpr int kVersionPatch = @MICRO_FORGE_VERSION_PATCH@;
inline constexpr std::string_view kVersion = "@MICRO_FORGE_VERSION@";

} // namespace micro_forge
