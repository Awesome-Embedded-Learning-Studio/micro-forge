# AELS 统一 .clang-format 基线 | clang-format >= 19
# 模板来源:aels-standard 母仓。复制进新仓后就是本仓配置,可直接改;想追平上游再复制一次。
---
BasedOnStyle: LLVM
Standard: c++20                # 只影响格式化判断;语言标准由 CMake 声明
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4

# 大括号:K&R 附加式
BreakBeforeBraces: Attach

# 指针/引用:左贴(int* p)
PointerAlignment: Left
DerivePointerAlignment: false

# 类内布局
AccessModifierOffset: -4       # public: 落列 0
NamespaceIndentation: None
FixNamespaceComments: true

# include:默认保序(教学仓依赖讲解顺序);产品仓可覆盖为 Regroup + 三级 Categories
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# 短语句
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# 对齐:赋值/声明不做连续对齐(朴素档);宏保留对齐(寄存器表收益大)
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: AcrossComments
AlignTrailingComments: true
AlignEscapedNewlines: Right
AlignAfterOpenBracket: Align
AlignOperands: true

# 空格
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: true
SpaceInEmptyParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# 换行与文件
IndentPPDirectives: AfterHash
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakTemplateDeclarations: Yes  # clang-format 19+ 键名(旧名 AlwaysBreakTemplateDeclarations 作废)
MaxEmptyLinesToKeep: 1
InsertBraces: true              # 单语句强制大括号;教学示例仓可覆盖为 false
InsertNewlineAtEOF: true
LineEnding: LF
ReflowComments: true
